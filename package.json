{
	"name": "premovedprep-app",
	"version": "0.9.2",
	"private": true,
	"author": {
		"name": "Premoved",
		"email": "contact@premoved.com"
	},
	"license": "AGPL-3.0-only",
	"main": "shell/main.js",
	"scripts": {
		"ng": "ng",
		"preserve": "npm run assets",
		"serve": "ng serve",
		"prebuild": "npm run assets",
		"build": "ng build",
		"postbuild": "node tools/collect-licenses.mjs",
		"start": "npm run build && electron .",
		"electron": "electron .",
		"pack": "npm run build && electron-builder --dir",
		"dist": "npm run build && electron-builder --win nsis portable --publish never",
		"watch": "ng build --watch --configuration development",
		"test": "ng test",
		"check:signals": "node tools/check-signal-calls.mjs",
		"check:bindings": "node tools/check-bindings.mjs src",
		"check:replay": "node tools/check-replay.mjs",
		"check:uci": "tsc --strict --target ES2022 --module nodenext --moduleResolution nodenext --outDir dist/uci-check tools/uci-session-check.ts && node dist/uci-check/tools/uci-session-check.js",
		"check": "npm run check:signals && npm run check:bindings && npm run check:uci && npm run check:replay && npm run lint && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
		"lint": "ng lint",
		"assets:pieces": "node tools/fetch-lichess-pieces.mjs",
		"assets": "npm run assets:pieces",
		"dist:mac": "npm run build && electron-builder --mac dmg --publish never",
		"dist:linux": "npm run build && electron-builder --linux AppImage --publish never",
		"engine": "node tools/fetch-engine.mjs"
	},
	"dependencies": {
		"chess.js": "^1.4.0"
	},
	"devDependencies": {
		"@angular/build": "^21.2.10",
		"@angular/cli": "^21.2.10",
		"@angular/common": "^21.2.0",
		"@angular/compiler": "^21.2.0",
		"@angular/compiler-cli": "^21.2.0",
		"@angular/core": "^21.2.0",
		"@angular/forms": "^21.2.0",
		"@angular/platform-browser": "^21.2.0",
		"@angular/router": "^21.2.0",
		"@eslint/js": "^10.0.1",
		"@lichess-org/chessground": "^10.1.1",
		"@types/chess.js": "^0.13.7",
		"angular-eslint": "21.4.0",
		"electron": "^44.2.0",
		"electron-builder": "^26.0.0",
		"eslint": "^10.3.0",
		"jsdom": "^28.0.0",
		"prettier": "^3.9.8",
		"rxjs": "~7.8.0",
		"tslib": "^2.3.0",
		"typescript": "~5.9.2",
		"typescript-eslint": "8.59.2",
		"vitest": "^4.0.8"
	},
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"esbuild@0.28.1": true,
		"lmdb@3.5.1": true,
		"msgpackr-extract@3.0.4": true
	}
}
